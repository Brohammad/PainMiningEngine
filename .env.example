REDDIT_CLIENT_ID=replace-me
REDDIT_CLIENT_SECRET=replace-me
REDDIT_USER_AGENT=signalmine/0.1 by your-reddit-username
REDDIT_REQUEST_TIMEOUT_SECONDS=10
REDDIT_RATE_LIMIT_WAIT_SECONDS=60
REDDIT_RETRY_ATTEMPTS=3
REDDIT_RETRY_BACKOFF_SECONDS=1.0
REDDIT_COMMENT_LIMIT=20
REDDIT_COMMENT_MAX_DEPTH=3

EXTRACTION_API_KEY=replace-me
EXTRACTION_MODEL=replace-me
EXTRACTION_BASE_URL=https://api.openai.com/v1
EXTRACTION_INSTRUCTOR_MODE=tools
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_VALIDATION_RETRIES=2

DATABASE_URL=postgresql+psycopg://signalmine:replace-me@localhost:5432/signalmine
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true

OBSERVABILITY_SERVICE_NAME=signalmine
OBSERVABILITY_SERVICE_VERSION=0.1.0
OBSERVABILITY_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0
OBSERVABILITY_REQUEST_ID_HEADER=X-Request-ID
